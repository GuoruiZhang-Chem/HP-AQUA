#-----------------------------------------------------------------------
# Rules.

lib : libpes_h3o.a 

.PHONY : lib clean realclean
.SUFFIXES : $(nil)
.SUFFIXES : .f90 .o .exe
FORCE :

# Autogenerated dependency file
#include .depend

# Pattern rule to make %.o file
.f90.o :
	$(FC) -c $(FFLAGS) $<

# Here are the rules to make the libraries.
libpes_h3o.a : $(objlib)
	\rm -f $@
	$(BLD) $(@F) $(objlib)


# Targets 'clean' and 'realclean' clean up the directory.
clean : FORCE
	rm -f *.o *~ core junk
realclean : clean
	rm -f *.a *.mod *.exe

